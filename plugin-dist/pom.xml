<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.hauch</groupId>
        <artifactId>hholograms</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>plugin-dist</artifactId>
    <name>hHolograms (Distribution)</name>
    <packaging>jar</packaging>

    <dependencies>
        <dependency><groupId>dev.hauch</groupId><artifactId>core</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_18_R2</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_19_R1</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_19_R2</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_19_R3</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_20_R1</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_20_R2</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_20_R3</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_20_R4</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_21_R1</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_21_R2</artifactId></dependency>
        <dependency><groupId>dev.hauch</groupId><artifactId>v1_21_R3</artifactId></dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>hHolograms-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <artifactSet>
                                <includes>
                                    <include>dev.hauch:core</include>
                                    <include>dev.hauch:v1_18_R2</include>
                                    <include>dev.hauch:v1_19_R1</include>
                                    <include>dev.hauch:v1_19_R2</include>
                                    <include>dev.hauch:v1_19_R3</include>
                                    <include>dev.hauch:v1_20_R1</include>
                                    <include>dev.hauch:v1_20_R2</include>
                                    <include>dev.hauch:v1_20_R3</include>
                                    <include>dev.hauch:v1_20_R4</include>
                                    <include>dev.hauch:v1_21_R1</include>
                                    <include>dev.hauch:v1_21_R2</include>
                                    <include>dev.hauch:v1_21_R3</include>
                                </includes>
                            </artifactSet>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>dev.hauch.hholograms.HHolograms</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>